# Modele des variables d'environnement.
#
# Ce fichier EST versionne : il montre les noms des variables a renseigner.
# Le fichier .env, lui, contient les vraies valeurs et n'est JAMAIS versionne.

# --- Mode de fonctionnement ------------------------------------------------
# 1 = application locale, avec capture des paquets
# 0 = application en ligne, lecture seule des resultats enregistres
CAPTURE_LOCALE=1

# --- Serveur web ------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
DEBUG=0

# --- Capture ----------------------------------------------------------------
# Nombre de paquets conserves en memoire pour l'affichage
TAILLE_TAMPON=500

# Interface ecoutee par defaut (laisser vide pour choisir dans l'interface)
INTERFACE_DEFAUT=

# --- Base de donnees Supabase ----------------------------------------------
# L'URL du projet et la cle publique ne sont pas des secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# La cle a privileges eleves ne doit JAMAIS etre versionnee ni partagee.
# Elle se saisit uniquement dans le fichier .env local, et dans les variables
# d'environnement de l'hebergeur.
#
# Deux noms acceptes, pour la meme chose :
#
#   SUPABASE_SECRET_KEY       la cle moderne « sb_secret_... »
#                             (Supabase -> Settings -> API Keys -> Secret keys)
#
#   SUPABASE_SERVICE_ROLE_KEY la cle historique « service_role »
#                             (meme page, section « Legacy API keys »)
#                             Elle reste valable, et elle est consultable a tout
#                             moment — alors que la cle moderne ne s'affiche
#                             qu'une seule fois, au moment de sa creation.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Comptes utilisateurs (cloisonnement des donnees) ----------------------
# Chaque capture est rattachee au compte qui l'a produite. Les comptes sont
# ceux de Supabase Auth (courriel + mot de passe).
#
# FLASK_SECRET_KEY signe le cookie de session. Absente, une cle est calculee a
# partir de SUPABASE_URL et de SUPABASE_SECRET_KEY : la session fonctionne, mais
# laisser la valeur vide en production n'est pas recommande.
FLASK_SECRET_KEY=

# Compte de cette machine : l'instance locale s'y connecte toute seule, et les
# captures qu'elle enregistre sont attribuees a ce compte (et non a un compte
# unique partage par tout le monde).
ANALYSEUR_COMPTE_COURRIEL=
ANALYSEUR_COMPTE_MOT_DE_PASSE=

# 1 = la creation de comptes est ouverte depuis l'application, 0 = fermee.
INSCRIPTION_OUVERTE=1

# 1 = l'accueil affiche les identifiants du compte de demonstration.
MONTRE_COMPTE_DEMONSTRATION=1
COMPTE_DEMONSTRATION_COURRIEL=
COMPTE_DEMONSTRATION_MOT_DE_PASSE=

# 1 = le cookie de session n'est transmis qu'en HTTPS. Laisser vide en local
# (HTTP), et laisser a 1 en ligne.
SESSION_COOKIE_SECURE=
